# Database Configuration
DB_HOST=localhost
DB_NAME=guataparo
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Application Configuration
APP_NAME="Sistema Guataparo"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/php_system/public

# Security
SESSION_LIFETIME=7200
CSRF_ENABLED=true

# Fingerprint SDK
FINGERPRINT_SDK_PATH=./Futronic
FINGERPRINT_DEMO_MODE=false
FINGERPRINT_ENCRYPTION_KEY="CAMBIAR_POR_CLAVE_SEGURA_DE_32_CARACTERES"

# Bridge local del lector de huellas (corre en la PC Windows con el lector físico)
BRIDGE_LOCAL_URL=http://localhost:8888

# Logging
LOG_LEVEL=debug
LOG_PATH=./logs

# Mail Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contrasena_de_aplicacion
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=tu_correo@gmail.com
MAIL_FROM_NAME="Sistema Guataparo"
