# Disable Directory Browsing
Options -Indexes

# Enable Rewrite Engine
RewriteEngine Off

# Set the base directory
RewriteBase /php_system/public/

# If the requested filename exists, simply serve it
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route all other requests to index.php with the action parameter
# Handle URLs like /socios -> index.php?action=socios
RewriteRule ^([a-zA-Z_]+)/?$ index.php?action=$1 [QSA,L]

# Handle URLs like /socios/create -> index.php?action=socios_create
RewriteRule ^([a-zA-Z_]+)/([a-zA-Z_]+)/?$ index.php?action=$1_$2 [QSA,L]
